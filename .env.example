# Copy to .env to override. One file for the whole repo: the backend and Vite both read it.
#
# The backend loads it itself: `backend/src/env.ts` — the FIRST import in
# `backend/src/server.ts` — calls `process.loadEnvFile` on this file, resolved from the
# repo root. There is no `--env-file` flag anywhere, and none to forget: plain
# `node backend/src/server.ts` picks it up. A missing .env is fine (a fresh clone and CI
# have none); one that exists and cannot be opened throws at boot rather than booting a
# silently token-less process.
#
# The environment still wins over this file — a variable already set by the shell or by a
# parent process is never overridden, which is how the test suite and `e2e/fixtures.ts`
# point a server at a throwaway STATE_DIR and DB_PATH.
#
# Vite reads the same file because `frontend/vite.config.ts` sets `envDir` to the repo root.
# Only VITE_-prefixed names reach client code, so the secrets below are never bundled.


# ─── Server-side ──────────────────────────────────────────────────────────────────────────

# GitHub API token for Accept. Fine-grained: Contents + Pull requests write, Metadata read,
# scoped to the repos the board publishes to. Two things break without it:
#   - Accept cannot push the ticket branch or open the PR, and answers 500
#     `missing_github_token`.
#   - `DELETE /worktree` fails closed — it cannot verify the PR is safe to orphan, so it
#     refuses with `pr_state_unknown` rather than discarding an unmerged branch.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub webhook secrets, one per target repo, for HMAC-verifying `POST /webhooks/github`.
# Read by nothing today (memory/github.md): the receiver is unauthenticated because it is only
# reachable on the tailnet. They become load-bearing the moment that endpoint is exposed to the
# public internet — a tunnel, Smee, or a hosted deploy.
WEBHOOK_10X=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_10X_TEST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the board's API listens on. Default 4010, which the Vite dev proxy hardcodes, so
# changing it means changing `server.proxy` in frontend/vite.config.ts too.
PORT=4010

# Where 10x keeps its own state — the database, run prompt files, session dirs. Default
# `~/.10x`. Read at module load, so it cannot be changed after boot.
STATE_DIR=

# SQLite file. Default `$STATE_DIR/10x.db`. Also read at module load, by `db.ts`, which opens
# the database on import.
DB_PATH=

# Herdr's control socket. Default `~/.config/herdr/herdr.sock`. Herdr only injects this into
# panes it manages, so a standalone backend derives the default itself (memory/socket.md).
HERDR_SOCKET_PATH=

# Port-block pool for per-ticket dev servers (memory/architecture.md). With the defaults the
# pool is 4100-4199, clear of the board on 4010 and the e2e harness on 4310. A block is
# reserved at spawn, so MAX_PORT_SLOTS is also a cap on tickets in progress or in review: the
# next spawn is refused with `port_pool_exhausted`, not queued. A malformed value throws at
# load rather than falling back, so a typo cannot masquerade as the default.
MAX_PORT_SLOTS=10
PORT_BLOCK_BASE=4100
PORT_BLOCK_STRIDE=10


# ─── Client-side ──────────────────────────────────────────────────────────────────────────
# Vite only exposes VITE_-prefixed variables to the client, and inlines them at build time —
# a rebuild is required for a change to take effect.

# Per-card diagnostics panel: eleven spawn counters and timings (memory/spawn.md). Off by
# default because it is a debugging surface, not a board feature.
VITE_DIAGNOSTICS=false

# Renders the board from `src/mock.ts` fixtures and starts no poll, for working on the UI with
# no backend running. Real data is the default: only the exact string "true" turns this on.
VITE_MOCK_MODE=false

# The user@host passed to `herdr --remote <ssh-target>` for the top-bar Steer button's Remote
# mode. Only consulted when that mode is active; unset means the attach command is not copied,
# though the pane is still focused.
VITE_HERDR_REMOTE_TARGET=
