# Copy to frontend/.env to override. Vite only exposes VITE_-prefixed variables to the client,
# and inlines them at build time — a rebuild is required for a change to take effect.

# Per-card diagnostics panel: eleven spawn counters and timings (memory/spawn.md). Off by
# default because it is a debugging surface, not a board feature.
VITE_DIAGNOSTICS=false

# Renders the board from `src/mock.ts` fixtures and starts no poll, for working on the UI with
# no backend running. Real data is the default: only the exact string "true" turns this on.
VITE_MOCK_MODE=false

# The user@host passed to `herdr --remote <ssh-target>` for the top-bar Steer button's Remote
# mode. Only consulted when that mode is active; unset means the attach command is not copied,
# though the pane is still focused.
VITE_HERDR_REMOTE_TARGET=
