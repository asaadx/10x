{
  "name": "10x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @10x/backend dev",
    "dev:web": "pnpm --filter @10x/frontend dev",
    "start": "pnpm build && node backend/src/server.ts",
    "build": "pnpm --filter @10x/frontend build",
    "typecheck": "tsc --noEmit && pnpm --filter @10x/frontend typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm build && playwright test --project=fast",
    "e2e:full": "pnpm build && playwright test --project=full",
    "demo:real-agent-pr": "pnpm build && node e2e/demo-backlog-to-done.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.2"
  }
}
