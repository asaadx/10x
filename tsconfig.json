{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    // Node strips types rather than compiling them, so parameter properties and enums
    // fail at LOAD time. This makes tsc reject them instead of finding out at runtime.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["backend/src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
